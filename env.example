# Copy to .env.local for `next dev` / `next start` (admin API loads config from disk).
# Bot layout: $CTI_BASE/<CTI_BOT_NAME>/config.env  (default CTI_BASE = ~/.claude-to-im)
#
# Option A — recommended: name the bot directory (slug)
CTI_BOT_NAME=default
#
# Option B: full path to bot data directory (overrides CTI_BOT_NAME)
# CTI_HOME=/Users/you/.claude-to-im/default
#
# Optional: override base directory (default ~/.claude-to-im)
# CTI_BASE=/path/to/claude-to-im-root
#
# Graceful bridge shutdown: send Telegram/Discord HTTP notify (uses imBot.proxy or CTI_PROXY). Set to 1 to disable.
# CTI_SHUTDOWN_NOTIFY_DISABLED=1
