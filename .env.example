# Minimal env for Kanban (board, workflow, agent runners, optional Telegram).
#
# Usage:
#   cp .env.example .env.local
#   # edit placeholders, then: npm run dev
#
# Data directory: ~/.claude-to-im/<CTI_BOT_NAME>/  (override with CTI_HOME)
# Platform DB:   <project>/data/platform/platform.db (default; cwd = repo root when running `npm run dev`)
# To use the old path under bridge home: CTI_KANBAN_PLATFORM_DIR=cti-home
# Or set a custom dir: CTI_KANBAN_PLATFORM_DIR=/absolute/or/relative/path
#
# loadConfig() also reads $CTI_HOME/config.env — for identical agent settings in prod,
# copy the same key=value lines into that file (or symlink .env.local → config.env).

# --- Required: stable bot data dir (see also env.example) ---
CTI_BOT_NAME=kanban

# --- Required for Claude-based Kanban agents (developer/reviewer lanes) ---
ANTHROPIC_API_KEY=
# CLI used for Kanban agent runs (default: resolveClaudeCliPath in llm-provider; often ~/.local/bin/claude)
# CTI_CLAUDE_CODE_EXECUTABLE=/Users/you/.local/bin/agent
# npm run dev also prepends PATH with /opt/homebrew/bin and $HOME/.local/bin (spawn git / agent)
# Kanban Git: we spawn `git` by name and prepend PATH (Homebrew on macOS, optional dir from):
# CTI_GIT_EXECUTABLE=/opt/homebrew/bin/git

# --- Default repo path for agents (optional; defaults to process.cwd()) ---
# CTI_DEFAULT_WORKDIR=/path/to/your/git/repo

# --- Kanban → Telegram (outbound sendMessage; both required to send, omit to disable) ---
CTI_KANBAN_TELEGRAM_BOT_TOKEN=
CTI_KANBAN_TELEGRAM_CHAT_ID=
# CTI_KANBAN_TELEGRAM_PROXY=http://127.0.0.1:7890
# CTI_KANBAN_TELEGRAM_MESSAGE_THREAD_ID=
# CTI_KANBAN_TELEGRAM_SKIP_ASSISTANT=1

# --- Kanban workflow (optional) ---
# CTI_KANBAN_WORKFLOW_AUTO=0
# Isolated task worktrees (default ON). Set to 0 to disable.
CTI_KANBAN_USE_WORKTREE=1
# Max automated system_check rounds without a workflow column change (default 100); at limit, Telegram asks for human intervention.
# CTI_KANBAN_CONFIRMATION_MAX_LOOPS=100
#
# Per agent turn / system_check: max time to wait for the provider stream (default 300000 ms = 5 min). Set to 0 to disable.
# CTI_KANBAN_STREAM_TIMEOUT_MS=300000
# After a timed-out stream, how many extra attempts (default 3 → 4 tries total). Set to 0 for a single attempt only.
# CTI_KANBAN_STREAM_TIMEOUT_RETRIES=3
# After a runtime error (failed stream / provider error), how many extra attempts (default 2 → 3 tries total). Set to 0 for a single attempt only.
# CTI_KANBAN_RUNTIME_ERROR_RETRIES=2
#
# SCM API token for creating PR/MR (submit review, workflow auto-advance). Used when the project has no
# repository.scmTokenEnvVar in /projects, or matches that name. GitHub: GITHUB_TOKEN, then GH_TOKEN, then
# `gh auth token` if GitHub CLI is installed and logged in (`gh auth login`). GitLab: GITLAB_TOKEN.
# CTI_SCM_DISABLE_GH_CLI=1
GITHUB_TOKEN=
# GH_TOKEN=
# GITLAB_TOKEN=

# --- Bridge-style config (optional; defaults inside loadConfig if unset) ---
# CTI_RUNTIME=claude
# CTI_PROXY=http://127.0.0.1:7890
